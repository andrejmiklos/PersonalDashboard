#!/bin/sh
# Blocks commits that contain secrets. Installed via `npm install` (core.hooksPath).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found. Install it: https://github.com/gitleaks/gitleaks#installing" >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner
