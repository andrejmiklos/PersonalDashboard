// Template for the Worker configuration.
// Copy to `wrangler.jsonc` (git-ignored) and fill in your own values.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-dashboard",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-dashboard",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Optional custom domain instead of *.workers.dev:
  // "routes": [{ "pattern": "dashboard.example.com", "custom_domain": true }]
}
