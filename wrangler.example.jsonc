// Template for the Worker configuration.
// Copy to `wrangler.jsonc` (git-ignored) and fill in your own values.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-dashboard",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  // Serve on *.workers.dev, but do not publish a separate public URL for every uploaded version.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/healthz"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-dashboard",
      // Paste the id printed by `wrangler d1 create personal-dashboard`.
      // Decline its offer to add a binding: it appends a second entry instead of updating this one.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Per-IP limits (docs/06-security-and-public-repo.md §6). namespace_id: any integer string, unique in the
  // account. Without these entries the Worker runs without rate limiting.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "PAIR_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
  ],
  // Optional custom domain instead of *.workers.dev:
  // "routes": [{ "pattern": "dashboard.example.com", "custom_domain": true }]
}
